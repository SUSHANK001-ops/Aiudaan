dd = pd.read_csv("Datasets/daraz_dataset.csv")


category = dd.groupby("Category")["Product"].count()
plt.bar(category.index, category.values ,color = 'green' ,edgecolor="blue")





category


plt.pie(category.values, labels=category.index, explode=(0.1,0,0,0,0,0,0))
plt.figure(figsize=(12, 12))


dd


gender = dd.groupby("Gender")["Product"].count()
gender


plt.pie(gender, labels=gender.index, colors=["Pink", "Green"], explode=(0,0.2))
plt.title("Products by Gender")


bins = [0, 5000, 10000, 20000, 30000, 80000]
plt.hist(dd['UnitPrice'], bins=bins, color="green", edgecolor='red')



